# ==============================================================================
# ATS — Unified Environment Configuration
# ==============================================================================
# One .env file for the entire project (Frontend + Backend).
#
# FOR LOCAL DEVELOPMENT:
#   Copy this file to `.env`:
#     cp .env.example .env
#
# FOR VERCEL DEPLOYMENT:
#   Add these variables in your Vercel Project Settings -> Environment Variables.
#   Only MONGODB_URI and JWT_SECRET are required!
# ==============================================================================

# Database: MongoDB connection string (Required)
# Local: mongodb://127.0.0.1:27017/ats
# Vercel / Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ats
MONGODB_URI=mongodb://127.0.0.1:27017/ats

# Authentication Secret (Required)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# API & Client URLs (Optional)
# In local dev: API runs on 5000, Web runs on 3000.
# On Vercel: Both run together automatically under the same URL, so these are not needed!
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# File Uploads (Optional)
MAX_RESUME_MB=5

# AI Resume Screening & Assistant (Optional - leave empty to disable)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
