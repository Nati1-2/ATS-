# Copy to .env.production and fill in. Never commit the real file.

# Long random secret for signing sessions: generate with `openssl rand -hex 32`
JWT_SECRET=

# Public URL people use to reach the app (used in invite and password-reset links)
CLIENT_URL=https://careers.example.com

# true when served over HTTPS (recommended). false only for a plain-HTTP trial on a private network.
COOKIE_SECURE=true

# Port the web app is published on
WEB_PORT=3000

# Max CV upload size in MB
MAX_RESUME_MB=5

# Optional AI CV analysis (Google Gemini). Leave empty to turn AI off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
