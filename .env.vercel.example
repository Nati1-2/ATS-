# ─── Vercel Deployment ───────────────────────────────────────────────
# Copy these values into your Vercel project's Environment Variables
# (Settings → Environment Variables). Never commit real secrets.
#
# Deploy steps:
#   1. Push this repo to GitHub
#   2. Import it at https://vercel.com/new (no need to set Root Directory)
#   3. Add the environment variables below
#   4. Deploy!

# ─── Required ────────────────────────────────────────────────────────

# MongoDB Atlas connection string (create a free cluster at https://mongodb.com/atlas)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ats

# Long random secret for signing sessions: generate with `openssl rand -hex 32`
JWT_SECRET=

# ─── Optional ────────────────────────────────────────────────────────

# Public URL of the app (defaults to your Vercel project's production URL)
# Only set this if you use a custom domain.
# CLIENT_URL=https://hiring.yourcompany.com

# Max CV upload size in MB (default 5, Vercel caps request bodies at 4.5 MB)
# MAX_RESUME_MB=5

# ─── AI (optional — leave empty to turn AI features off) ─────────────

# Google Gemini API key (get one at https://aistudio.google.com)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash
