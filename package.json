{
  "name": "ats",
  "version": "1.0.0",
  "private": true,
  "description": "Applicant Tracking System — Next.js + Express + MongoDB",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build --prefix client",
    "start": "concurrently -n api,web \"npm start --prefix server\" \"npm start --prefix client\"",
    "test": "npm test --prefix server",
    "test:e2e": "npm test --prefix e2e",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
