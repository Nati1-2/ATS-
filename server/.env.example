PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ats
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000
# Max résumé size in megabytes
MAX_RESUME_MB=5
NODE_ENV=development

# AI CV analysis (optional). Get a key at https://aistudio.google.com — never commit it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when a model's quota runs out (free tiers allow only ~20 requests/day per model)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Rate limits per IP (optional). Offices often share one IP, so successful sign-ins never count.
# LOGIN_FAILURES_PER_15_MIN=20
# ACCOUNT_REQUESTS_PER_15_MIN=30
# APPLICATIONS_PER_HOUR=60
